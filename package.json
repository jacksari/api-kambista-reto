    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.2.3",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "supertest": "^7.2.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
